import { Directive, ElementRef, AfterViewInit } from '@angular/core';

@Directive({
  selector: '[appUppercase]'
})
export class UppercaseDirective implements AfterViewInit {
  constructor(private el: ElementRef) {}

  ngAfterViewInit() {
    const text = this.el.nativeElement.innerText;
    this.el.nativeElement.innerText = text.toUpperCase();

    console.log('UppercaseDirective works — text converted to UPPERCASE');
}
}



import { Directive, HostListener } from '@angular/core';

@Directive({
  selector: '[appNumbersOnly]'
})
export class NumbersOnlyDirective {
  @HostListener('input', ['$event'])
  onInput(event: Event): void {
    const input = event.target as HTMLInputElement;
    const filtered = input.value.replace(/[^0-9]/g, '');
    if (input.value !== filtered) {
      input.value = filtered;
    }

    console.log('NumbersOnlyDirective works — only digits 0‑9 allowed');
  }
}



