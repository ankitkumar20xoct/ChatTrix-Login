## 🟡 Optional: If You Want to Keep Tests (for learning)

If you really want those tests to compile (you don’t need to, but here’s how),  
mock the dependencies *loosely* by casting them to `any` or `unknown`:

### Example — rotate.spec.ts
```ts
import { ElementRef, Renderer2 } from '@angular/core';
import { RotateDirective } from './rotate.directive';

describe('RotateDirective', () => {
  it('should create an instance', () => {
    const elementRef = new ElementRef(document.createElement('div'));
    const mockRenderer: Renderer2 = { setStyle: () => {} } as unknown as Renderer2;
    const directive = new RotateDirective(elementRef, mockRenderer);
    expect(directive).toBeTruthy();
  });
});
```

### Example — scale.spec.ts
```ts
import { ElementRef, Renderer2 } from '@angular/core';
import { ScaleDirective } from './scale.directive';

describe('ScaleDirective', () => {
  it('should create an instance', () => {
    const el = new ElementRef(document.createElement('div'));
    const renderer = {} as unknown as Renderer2;
    const directive = new ScaleDirective(el, renderer);
    expect(directive).toBeTruthy();
  });
});
```

Same idea for **shadow.spec.ts** — pass `ElementRef` and `Renderer2` mocks.

