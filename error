### 🔹 1. `src/app/login/directives/blink.directive.ts`

```ts
import { Directive, ElementRef, OnInit } from '@angular/core';

@Directive({
  selector: '[appBlink]'
})
export class BlinkDirective implements OnInit {
  constructor(private el: ElementRef) {}

  ngOnInit() {
    setInterval(() => {
      const visibility = this.el.nativeElement.style.visibility;
      this.el.nativeElement.style.visibility = visibility === 'hidden' ? 'visible' : 'hidden';
    }, 400);
  }
}
```

