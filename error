### 🔹 6. `src/app/login/login.component.ts`

If you are using **standalone components**, use this:

```ts
import { Component } from '@angular/core';
import { HighlightDirective } from './directives/highlight.directive';
import { BlinkDirective } from './directives/blink.directive';
import { RotateDirective } from './directives/rotate.directive';
import { ShadowDirective } from './directives/shadow.directive';
import { ScaleDirective } from './directives/scale.directive';

@Component({
  selector: 'app-login',
  standalone: true,
  templateUrl: './login.component.html',
  styleUrls: ['./login.component.css'],
  imports: [
    HighlightDirective,
    BlinkDirective,
    RotateDirective,
    ShadowDirective,
    ScaleDirective
  ]
})
export class LoginComponent {}
```

If your project uses the older **NgModule-based** setup, use this simpler component:

```ts
import { Component } from '@angular/core';

@Component({
  selector: 'app-login',
  templateUrl: './login.component.html',
  styleUrls: ['./login.component.css']
})
export class LoginComponent {}
```

…and declare this component + all directives in your `AppModule`.

