## 🧩 2️⃣ `numbers-only.directive.ts`

```typescript
import { Directive, HostListener } from '@angular/core';

// 👇 Custom Directive Definition — appNumbersOnly
@Directive({
  // Selector used as an attribute on input fields
  selector: '[appNumbersOnly]'
})
export class NumbersOnlyDirective {

  // 👂 HostListener listens to the input event on the element this directive is applied to
  @HostListener('input', ['$event'])
  onInput(event: Event): void {

    // Cast the event target to an input element to access its value
    const input = event.target as HTMLInputElement;

    // Replace everything that is not a digit (0–9) with an empty string using regex
    const filtered = input.value.replace(/[^0-9]/g, '');

    // If the user typed non-numeric characters, remove them immediately
    if (input.value !== filtered) {
      input.value = filtered;
    }

    // Debug log message
    console.log('NumbersOnlyDirective works — only digits 0‑9 allowed');
  }
}
```

💡 **What it does:**  
Prevents users from entering letters or symbols in inputs. It keeps only digits (`0–9`).

**Example:**
```html
<input type="text" appNumbersOnly />
<!-- Typing abc123 → becomes 123 -->
```

